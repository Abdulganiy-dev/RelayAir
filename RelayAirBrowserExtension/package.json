{
  "name": "relayair-form-detector",
  "version": "0.1.0",
  "private": true,
  "description": "Headless browser extension that detects webpage form fields and their positions",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.0"
  }
}
