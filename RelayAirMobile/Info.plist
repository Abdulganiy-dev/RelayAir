<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode merges the GENERATE_INFOPLIST_FILE keys into this file, so only
	     the ones it can't express as build settings live here.
	     NSBonjourServices is an array, which INFOPLIST_KEY_* can't represent. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_relayair._tcp</string>
		<string>_relayair._udp</string>
	</array>
</dict>
</plist>
